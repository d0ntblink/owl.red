config interface 'loopback'
        option device 'lo'
        option proto 'static'
        option ipaddr '127.0.0.1'
        option netmask '255.0.0.0'

config device 'ap_bridge'
        option name '{{ openwrt_bridge }}'
        option type 'bridge'
        option vlan_filtering '1'
        option macaddr '{{ openwrt_expected_uplink_mac }}'
        list ports '{{ openwrt_uplink }}'
{% for port in openwrt_private_ports %}
        list ports '{{ port }}'
{% endfor %}
        list ports '{{ openwrt_recovery_port }}'

config bridge-vlan 'management_vlan'
        option device '{{ openwrt_bridge }}'
        option vlan '{{ openwrt_native_management_vid }}'
        list ports '{{ openwrt_uplink }}:u*'
        list ports '{{ openwrt_recovery_port }}:u*'

config interface 'lan'
        option device '{{ openwrt_bridge }}.{{ openwrt_native_management_vid }}'
        option proto 'static'
        option ipaddr '{{ openwrt_management_host }}'
        option netmask '255.255.255.0'
        option gateway '{{ openwrt_management_gateway }}'
        option delegate '0'
        list dns '{{ openwrt_management_dns }}'

{% for name, network in openwrt_wifi_networks.items() %}
config bridge-vlan '{{ name }}_vlan'
        option device '{{ openwrt_bridge }}'
        option vlan '{{ network.vlan }}'
        list ports '{{ openwrt_uplink }}:t'
{% if name == 'private' %}
{% for port in openwrt_private_ports %}
        list ports '{{ port }}:u*'
{% endfor %}
{% endif %}

config device '{{ name }}_bridge'
        option name 'br-{{ name | replace("_", "-") }}'
        option type 'bridge'
        option bridge_empty '1'
        list ports '{{ openwrt_bridge }}.{{ network.vlan }}'

config interface '{{ name }}'
        option device 'br-{{ name | replace("_", "-") }}'
        option proto 'none'
        option delegate '0'

{% endfor %}