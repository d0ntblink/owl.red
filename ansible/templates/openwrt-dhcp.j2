config dnsmasq 'main'
        option port '0'
        option authoritative '0'
        option localservice '1'

config dhcp 'lan'
        option interface 'lan'
        option ignore '1'
        option ra 'disabled'
        option dhcpv6 'disabled'
        option ndp 'disabled'

{% for name in openwrt_wifi_networks %}
config dhcp '{{ name }}'
        option interface '{{ name }}'
        option ignore '1'
        option ra 'disabled'
        option dhcpv6 'disabled'
        option ndp 'disabled'

{% endfor %}
config odhcpd 'odhcpd'
        option maindhcp '0'