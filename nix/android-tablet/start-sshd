#!/data/data/com.termux/files/usr/bin/bash
set -eu
export HOME=/data/data/com.termux/files/home
export PREFIX=/data/data/com.termux/files/usr
export PATH="$PREFIX/bin:/system/bin"
mkdir -p "$PREFIX/var/run"
ssh-keygen -A
sshd -t -f "$HOME/.ssh/sshd_config"
pid_file="$PREFIX/var/run/owl-tablet-sshd.pid"
if [[ -f "$pid_file" ]]; then
    ssh_pid=$(cat "$pid_file")
    if [[ "$ssh_pid" =~ ^[0-9]+$ ]] && kill -0 "$ssh_pid" 2>/dev/null &&
        [[ "$(readlink "/proc/$ssh_pid/exe" 2>/dev/null)" = "$PREFIX/bin/sshd" ]]; then
        exit 0
    fi
fi
exec sshd -f "$HOME/.ssh/sshd_config"