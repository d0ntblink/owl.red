  <Config Name="NVIDIA GPU" Target="NVIDIA_VISIBLE_DEVICES" Default="" Mode="" Description="Same physical GPU as Plex" Type="Variable" Display="always" Required="true" Mask="false">GPU-c94e5971-7089-c23b-b3ab-361af1a1583c</Config>
  <Config Name="NVIDIA Capabilities" Target="NVIDIA_DRIVER_CAPABILITIES" Default="compute,video,utility" Mode="" Description="Hardware video acceleration" Type="Variable" Display="advanced" Required="true" Mask="false">compute,video,utility</Config>
  <Config Name="Published URL" Target="JELLYFIN_PublishedServerUrl" Default="" Mode="" Description="Intended browser address" Type="Variable" Display="advanced" Required="true" Mask="false">https://jellyfin.owl.red</Config>
  <Config Name="Timezone" Target="TZ" Default="America/Edmonton" Mode="" Description="Timezone" Type="Variable" Display="advanced" Required="true" Mask="false">America/Edmonton</Config>
