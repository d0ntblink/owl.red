{% set vyos_lab = vyos_router | default(vyos_lab) %}
firewall {
    ipv4 {
        forward {
            filter {
                default-action drop
                default-log
                rule 10 {
                    action accept
                    state established
                    state related
                }
                rule 20 {
                    action drop
                    log
                    state invalid
                }
                rule 100 {
                    action accept
                    description "LAN-TO-WAN"
                    inbound-interface {
                        name {{ vyos_lab.lan_interface }}
                    }
                    outbound-interface {
                        name {{ vyos_lab.wan_interface }}
                    }
                    source {
                        address {{ vyos_lab.subnet }}
                    }
                }
                rule 200 {
                    action accept
                    description "PLEX-DNAT"
                    destination {
                        address {{ vyos_lab.nas_address }}
                        port 32400
                    }
                    inbound-interface {
                        name {{ vyos_lab.wan_interface }}
                    }
                    protocol tcp
                }
{% if vyos_lab.reflection_ip is defined %}
                rule 210 {
                    action accept
                    description "PLEX-REFLECTION"
                    destination {
                        address {{ vyos_lab.nas_address }}
                        port 32400
                    }
                    inbound-interface {
                        name {{ vyos_lab.lan_interface }}
                    }
                    outbound-interface {
                        name {{ vyos_lab.lan_interface }}
                    }
                    protocol tcp
                }
{% endif %}
            }
        }
        input {
            filter {
                default-action drop
                default-log
                rule 10 {
                    action accept
                    state established
                    state related
                }
                rule 20 {
                    action drop
                    log
                    state invalid
                }
                rule 30 {
                    action accept
                    inbound-interface {
                        name lo
                    }
                }
                rule 40 {
                    action accept
                    destination {
                        port 67
                    }
                    inbound-interface {
                        name {{ vyos_lab.lan_interface }}
                    }
                    protocol udp
                    source {
                        port 68
                    }
                }
                rule 50 {
                    action accept
                    destination {
                        port 68
                    }
                    inbound-interface {
                        name {{ vyos_lab.wan_interface }}
                    }
                    protocol udp
                    source {
                        port 67
                    }
                }
                rule 60 {
                    action accept
                    destination {
                        port "22,53"
                    }
                    inbound-interface {
                        name {{ vyos_lab.lan_interface }}
                    }
                    protocol tcp
                    source {
                        address {{ vyos_lab.subnet }}
                    }
                }
                rule 70 {
                    action accept
                    destination {
                        port "53,123"
                    }
                    inbound-interface {
                        name {{ vyos_lab.lan_interface }}
                    }
                    protocol udp
                    source {
                        address {{ vyos_lab.subnet }}
                    }
                }
                rule 80 {
                    action accept
                    inbound-interface {
                        name {{ vyos_lab.lan_interface }}
                    }
                    protocol icmp
                    source {
                        address {{ vyos_lab.subnet }}
                    }
                }
            }
        }
    }
    ipv6 {
        forward {
            filter {
                default-action drop
                default-log
{% if vyos_lab.ipv6_enabled | default(false) %}
                rule 10 {
                    action accept
                    state established
                    state related
                }
                rule 20 {
                    action drop
                    state invalid
                }
                rule 100 {
                    action accept
                    inbound-interface {
                        name {{ vyos_lab.lan_interface }}
                    }
                    outbound-interface {
                        name {{ vyos_lab.wan_interface }}
                    }
                }
{% endif %}
            }
        }
        input {
            filter {
                default-action drop
                default-log
{% if vyos_lab.ipv6_enabled | default(false) %}
                rule 10 {
                    action accept
                    state established
                    state related
                }
                rule 20 {
                    action drop
                    state invalid
                }
                rule 30 {
                    action accept
                    protocol ipv6-icmp
                }
                rule 40 {
                    action accept
                    destination {
                        port 546
                    }
                    inbound-interface {
                        name {{ vyos_lab.wan_interface }}
                    }
                    protocol udp
                    source {
                        port 547
                    }
                }
                rule 60 {
                    action accept
                    destination {
                        port 53
                    }
                    inbound-interface {
                        name {{ vyos_lab.lan_interface }}
                    }
                    protocol tcp_udp
                }
{% endif %}
            }
        }
    }
}
interfaces {
    ethernet {{ vyos_lab.wan_interface }} {
        address dhcp
{% if vyos_lab.ipv6_enabled | default(false) %}
        address dhcpv6
        ipv6 {
            address {
                autoconf
            }
        }
        dhcpv6-options {
            no-release
            pd 0 {
                interface {{ vyos_lab.lan_interface }} {
                    address 1
                    sla-id 0
                }
                length 56
            }
        }
{% endif %}
        description "WAN"
{% if vyos_lab.dhcp_hostname is defined %}
        dhcp-options {
            host-name {{ vyos_lab.dhcp_hostname }}
        }
{% endif %}
        hw-id {{ vyos_lab.wan_mac }}
    }
    ethernet {{ vyos_lab.lan_interface }} {
        address {{ vyos_lab.address }}
        description "LAN"
        hw-id {{ vyos_lab.lan_mac }}
    }
    loopback lo {
    }
}
nat {
    destination {
        rule 100 {
            description "PLEX"
            destination {
                port 32400
            }
            inbound-interface {
                name {{ vyos_lab.wan_interface }}
            }
            protocol tcp
            translation {
                address {{ vyos_lab.nas_address }}
                port 32400
            }
        }
{% if vyos_lab.reflection_ip is defined %}
        rule 110 {
            description "PLEX-REFLECTION"
            destination {
                address {{ vyos_lab.reflection_ip }}
                port 32400
            }
            inbound-interface {
                name {{ vyos_lab.lan_interface }}
            }
            protocol tcp
            source {
                address {{ vyos_lab.subnet }}
            }
            translation {
                address {{ vyos_lab.nas_address }}
                port 32400
            }
        }
{% endif %}
    }
    source {
        rule 100 {
            description "MASQUERADE"
            outbound-interface {
                name {{ vyos_lab.wan_interface }}
            }
            source {
                address {{ vyos_lab.subnet }}
            }
            translation {
                address masquerade
            }
        }
{% if vyos_lab.reflection_ip is defined %}
        rule 110 {
            description "PLEX-REFLECTION-RETURN"
            destination {
                address {{ vyos_lab.nas_address }}
                port 32400
            }
            outbound-interface {
                name {{ vyos_lab.lan_interface }}
            }
            protocol tcp
            source {
                address {{ vyos_lab.subnet }}
            }
            translation {
                address masquerade
            }
        }
{% endif %}
    }
}
service {
    dhcp-server {
        listen-interface {{ vyos_lab.lan_interface }}
        shared-network-name {{ vyos_lab.network_name | default('LAB') }} {
            authoritative
            subnet {{ vyos_lab.subnet }} {
                lease {{ vyos_lab.lease_seconds }}
                option {
                    default-router {{ vyos_lab.gateway }}
                    domain-name {{ vyos_lab.domain }}
                    name-server {{ vyos_lab.gateway }}
                }
                range 0 {
                    start {{ vyos_lab.dhcp_start }}
                    stop {{ vyos_lab.dhcp_stop }}
                }
{% if vyos_lab.reservations is not defined %}
                static-mapping nas {
                    ip-address {{ vyos_lab.nas_address }}
                    mac {{ vyos_lab.nas_mac }}
                }
{% endif %}
                subnet-id 10
{% if vyos_lab.reservations is defined %}
                ignore-client-id
{% for reservation in vyos_lab.reservations %}
                static-mapping {{ reservation.name }} {
                    ip-address {{ reservation.ip }}
                    mac {{ reservation.mac }}
                }
{% endfor %}
{% endif %}
            }
        }
    }
    dns {
        forwarding {
            allow-from 127.0.0.0/8
            allow-from {{ vyos_lab.subnet }}
            listen-address 127.0.0.1
            listen-address {{ vyos_lab.gateway }}
{% if vyos_lab.ipv6_enabled | default(false) %}
            allow-from 2000::/3
            allow-from fe80::/10
            listen-address "::"
{% endif %}
        }
    }
    ntp {
        allow-client {
            address {{ vyos_lab.subnet }}
        }
        listen-address {{ vyos_lab.gateway }}
{% for server in vyos_lab.ntp_servers %}
        server {{ server }} {
        }
{% endfor %}
    }
    ssh {
        disable-password-authentication
        listen-address {{ vyos_lab.gateway }}
        port 22
    }
{% if vyos_lab.ipv6_enabled | default(false) %}
    router-advert {
        interface {{ vyos_lab.lan_interface }} {
            prefix ::/64 {
            }
        }
    }
{% endif %}
    suricata {
        address-group home-net {
            address {{ vyos_lab.subnet }}
        }
        address-group external-net {
            group "!home-net"
        }
{% for name in ['http-servers', 'smtp-servers', 'sql-servers', 'dns-servers', 'telnet-servers', 'dc-servers', 'dnp3-server', 'dnp3-client', 'modbus-client', 'modbus-server', 'enip-client', 'enip-server'] %}
        address-group {{ name }} {
            group home-net
        }
{% endfor %}
        address-group aim-servers {
            group external-net
        }
        interface {{ vyos_lab.lan_interface }}
        log {
            eve {
                filetype syslog
                type alert
                type anomaly
            }
        }
{% for name, ports in {'http-ports': ['80', '8080'], 'shellcode-ports': ['!80'], 'oracle-ports': ['1521'], 'ssh-ports': ['22'], 'dnp3-ports': ['20000'], 'modbus-ports': ['502'], 'file-data-ports': ['80', '8080', '110', '143'], 'ftp-ports': ['21'], 'geneve-ports': ['6081'], 'vxlan-ports': ['4789'], 'teredo-ports': ['3544']}.items() %}
        port-group {{ name }} {
{% for port in ports %}
            port {{ port | to_json }}
{% endfor %}
        }
{% endfor %}
    }
}
system {
    config-management {
        commit-revisions 100
        commit-confirm {
            action reload
        }
    }
    console {
        device ttyS0 {
            speed 115200
        }
    }
    domain-name {{ vyos_lab.system_domain }}
    host-name {{ vyos_lab.hostname }}
    login {
        user {{ vyos_lab.user }} {
            authentication {
                public-keys controller {
                    key {{ vyos_ssh_key_parts[1] | to_json }}
                    type ssh-ed25519
                }
            }
        }
    }
    name-server 127.0.0.1
    syslog {
        local {
            facility all {
                level info
            }
        }
    }
    static-host-mapping {
{% if vyos_lab.host_mappings is defined %}
{% for mapping in vyos_lab.host_mappings %}
        host-name {{ mapping.hostname }} {
            inet {{ mapping.ip }}
        }
{% endfor %}
{% else %}
        host-name nas.{{ vyos_lab.domain }} {
            inet {{ vyos_lab.nas_address }}
        }
{% endif %}
    }
    time-zone UTC
}